 *
 * nRF52 DK (PCA10040): the LSM6DSOX adapter on the Arduino SPI pins, SPIM2 with EasyDMA at
 * 8 MHz (the nRF52832 SPIM's top rate; the chip allows 10 MHz), SPI mode 3, chip-select D10.
 * Wiring: docs/ble_gatt.md 4.5. The virtual COM port runs at 1 Mbaud, no flow control.
 */
&uart0 {
	current-speed = <1000000>;
};

&spi2 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	cs-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>; /* D10 */

	vib_imu: lsm6dsox@0 {
		compatible = "st,lsm6dso";
		reg = <0>;
		spi-max-frequency = <8000000>;
	};
};
