CONFIG_ARM_MPU=y
CONFIG_GPIO=y

# No 32.768 kHz crystal on the Pill board (P0.00/P0.01 not connected): LFRC, calibrated
# against the HFXO by the clock driver's calibration timer. 500 ppm is the BLE
# sleep-clock figure for a calibrated LFRC on nRF52.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC_CALIBRATION=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_500PPM=y
