/*
 * Copyright (c) 2026 Het Bhavsar
 * SPDX-License-Identifier: Apache-2.0
 *
 * Atrium pod EVT, baseline 20.9 x 11 x 5.3 mm (approved 2026-11-07). Every nRF pin
 * below is a net in hardware/design-data/netlist/atrium_nets.yaml of the baseline; tests/check_pins.py
 * checks them.
 *
 * Power: cell -> AP6683 protection -> BQ21061 (power path: VSYS = PMID, 4.5 V on the Plinth,
 * about VBAT on the cell). TPS7A0218 makes VDD 1.8 V from VSYS for the nRF and the MAXM86161;
 * a second TPS7A0218 (U13, no enable pin) powers the IMU. MAXM86161A VLED = VSYS.
 * The nRF52832 regulator runs in DC/DC mode. No 32.768 kHz crystal: calibrated LFRC.
 * No LED, no buttons, no UART, no external flash. SWD on the flex contact pads.
 */

/dts-v1/;
#include <nordic/nrf52832_ciaa.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/regulator/nrf5x.h>
#include <zephyr/dt-bindings/sensor/lsm6dso.h>
#include "atrium_pod-pinctrl.dtsi"

/ {
	model = "Atrium pod EVT";
	compatible = "atrium,atrium-pod";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	aliases {
		watchdog0 = &wdt0;
		ppg0 = &ppg;
		imu0 = &imu;
		charger0 = &charger;
	};

	/* Thermal and supply sensing, used by src/hw/power_hw.c */
	zephyr,user {
		io-channels = <&adc 1>, <&adc 0>, <&adc 4>;
		io-channel-names = "th1_skin", "th4_top", "vsys";
		/* NTC_EN P0.17 -> R10 / R11 10 kOhm 0.1 % -> TH1 / TH4 (NCP03XH103) to GND */
		ntc-en-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;

		/* Cell and supply facts, read by src/main.c:
		 * - cell: Sharvi 400909, 30 mAh, AP6683 protection;
		 * - cut-off 3.30 V loaded on VSYS, off the Plinth;
		 * - green needs about 3.1 V on VLED (= VSYS) at the 31 mA range [VERIFY]: the
		 *   MAXM86161A green LED is 3.4 V max at 175 mA, 0.4 V under the MAXM86161's
		 *   3.8 V at 150 mA, so the old 3.5 V estimate drops by the same 0.4 V. With the
		 *   2.0 ohm sag the limit (3.13 V) sits under the 3.30 V cut-off: green runs to
		 *   the end of the charge. Measure on the bench (O-16);
		 * - cell resistance 2.0 ohm, end of life and cold [ASSUMED], set from the bench;
		 * - VSYS_SENSE = VSYS x R41 / (R40 + R41), 2.2 MOhm / 1 MOhm. */
		cell-capacity-mah = <30>;
		cutoff-mv = <3300>;
		green-min-mv = <3100>;
		cell-resistance-mohm = <2000>;
		vsys-sense-top-ohm = <2200000>;
		vsys-sense-bottom-ohm = <1000000>;

		/* LSM6DSOX (U11) axes to the pod frame: pod = M x chip, rows pod x, y, z.
		 * Pod frame (mechanical, worn vertically): +x along the long axis to the antenna
		 * end (up when worn), +z out of the top face (away from the head), +y = z x x.
		 * U11 on the top side, EasyEDA rot 270, pin 1 at the pod +x/+y corner, pins 1-4
		 * along the +y edge toward -x (PCB session, 2026-11-07). ST DS12814 figure 4 puts
		 * pin 1 at the chip's -X/+Y corner, pins 1-4 down the -X edge toward -Y (top view).
		 * So chip +Y = pod +x, chip +X = pod -y, Z = z [VERIFY by the bring-up gravity test,
		 * the pod resting on each of its six faces]. A layout change edits this one line. */
		imu-to-pod = <0 1 0  (-1) 0 0  0 0 1>;
	};
};

&reg {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

/* P0.21 -> TP1: pin reset for the bench */
&uicr {
	gpio-as-nreset;
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
	/* CHG_PG P0.14 edges by SENSE: the case's VIN patterns (src/power/vinpat.h) without a
	 * GPIOTE IN channel running in idle [VERIFY idle current on the bench] */
	sense-edge-mask = <(1 << 14)>;
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	/* TH1_SENSE P0.03/AIN1, skin side. 10 kOhm on top, NTC to GND. Ratiometric:
	 * gain 1/4 with the VDD/4 reference = VDD full scale, the rail NTC_EN drives. */
	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_VDD_1_4";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_AIN1>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
	};

	/* TH4_SENSE P0.02/AIN0 (was P0.30/AIN6 to 2026-11-08), top side, on the radio island next
	 * to the nRF. Same divider, gain and reference as TH1. */
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_VDD_1_4";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_AIN0>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
	};

	/* VSYS_SENSE P0.28/AIN4: VSYS / 3.2, 1.41 V at 4.5 V. Internal 0.6 V reference at
	 * gain 1/3 = 1.8 V full scale. 688 kOhm source: 40 us, plus the 100 nF hold cap C12. */
	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1_3";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN4>;
		zephyr,resolution = <12>;
	};
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	/* U3 MAXM86161A optical module, radio island (MAXM86161 register map) */
	ppg: maxm86161@62 {
		compatible = "adi,maxm86161";
		reg = <0x62>;
		/* PPG_INT P0.18 <- INTB, open drain, no pull-up on the board */
		int-gpios = <&gpio0 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		/* PPG_LDO_EN P0.20 -> LDO_EN, R5 1 MOhm pull-down */
		ldo-en-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
	};

	/* U11 LSM6DSOX (LSM6DSO register set), power island. INT2 not connected. */
	imu: lsm6dsox@6a {
		compatible = "st,lsm6dso";
		reg = <0x6a>;
		/* IMU_INT1 P0.12, push-pull, no pull: INT1 must be low or floating at IMU power-up */
		irq-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
		int-pin = <1>;
		/* accelerometer only; the modes set its rate */
		accel-odr = <LSM6DSO_DT_ODR_OFF>;
		/* XL_HM_MODE = 1: low-power at 12.5 Hz, normal at 104 Hz (DS12814 6.2). Power-up
		 * high-performance is 170 uA at any rate; low-power is 26 uA at 50 Hz, with 1.8 mg RMS
		 * noise at +-2 g against 70 ug/sqrt(Hz) (Table 3, Table 2). Not ultra-low-power: 5.5 mg */
		accel-pm = <LSM6DSO_DT_XL_LP_NORMAL_MODE>;
		gyro-odr = <LSM6DSO_DT_ODR_OFF>;
	};

	/* U10 BQ21061, power island. /LP low: I2C only while on the Plinth. */
	charger: bq21061@6b {
		compatible = "ti,bq21061";
		reg = <0x6b>;
		/* CHG_PG P0.14 <- /PG, open drain, R3 100 kOhm pull-up. Low on the Plinth. */
		pg-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
		/* 0.5C on the 30 mAh cell */
		constant-charge-current-max-microamp = <15000>;
		/* 5 mA, under 0.2C (6 mA) */
		cold-charge-current-microamp = <5000>;
	};
};

/*
 * 512 KB internal flash: MCUboot 32 KB | slot0 220 KB | slot1 220 KB | settings and bonds
 * 8 KB | log 32 KB (8 pages, src/logstore.c). MCUboot with ECDSA P-256 and swap-move is
 * 26.4 KB (src/sysbuild/mcuboot.conf).
 */
&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x00008000>;
		};
		slot0_partition: partition@8000 {
			label = "image-0";
			reg = <0x00008000 0x00037000>;
		};
		slot1_partition: partition@3f000 {
			label = "image-1";
			reg = <0x0003f000 0x00037000>;
		};
		storage_partition: partition@76000 {
			label = "storage";
			reg = <0x00076000 0x00002000>;
		};
		log_partition: partition@78000 {
			label = "log";
			reg = <0x00078000 0x00008000>;
		};
	};
};
