menuconfig MAXM86161
	bool "MAXM86161 optical module"
	default y
	depends on DT_HAS_ADI_MAXM86161_ENABLED
	select I2C
	select GPIO
	help
	  Driver for the MAXM86161A optical module (pod U3). The MAXM86161
	  has the same register map and part ID, so it runs either part.

if MAXM86161

config MAXM86161_INIT_PRIORITY
	int "Init priority"
	default 80

module = MAXM86161
module-str = maxm86161
source "subsys/logging/Kconfig.template.log_config"

endif # MAXM86161

config LSM6DSV16BX
	bool "LSM6DSV16BX accelerometer"
	default y
	depends on DT_HAS_ST_LSM6DSV16BX_ENABLED
	depends on SENSOR
	select I2C
	select GPIO
	help
	  Accelerometer of the pod's IMU (U11): rate, data-ready on INT1 and
	  x, y, z at +-2 g. The gyroscope, TDM and Qvar stay off.
